  "scripts": {
    "build": "node tools/clean-dist.mjs dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "pretest": "npx tsc --noEmit",
    "test": "npm run test:root",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "vitest bench tests/benchmarks/",
    "lint": "oxlint src/",
    "size": "node tools/check-size.mjs",
    "prepack": "npm run build",
    "check:package": "npm run build && node tools/check-package.mjs",
    "test:root": "vitest run",
    "build:packages": "npm run build --workspaces --if-present",
    "test:packages": "npm run build:packages && npm run test --workspace hilbras --workspace create-hilbras-app --workspace @hilbras/next --workspace @hilbras/react --workspace @hilbras/ui"
  },
