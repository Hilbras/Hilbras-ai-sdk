{
  "name": "@hilbras/sdk — one client for every model",
  "short_name": "Hilbras SDK",
  "description": "A TypeScript client for 23 model providers: streaming, tool calling and validated structured output behind one API, with no runtime dependencies.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#0c0b09",
  "theme_color": "#0c0b09",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
