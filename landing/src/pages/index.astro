---
import Logo from '../components/Logo.astro';
import SectionHead from '../components/SectionHead.astro';
import Tick from '../components/Tick.astro';
import { providers } from '../data/providers';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

/*
 * The strip renders the list twice on purpose: the animation translates by
 * exactly -50%, so the second copy is what the eye is reading when the first one
 * scrolls out of frame. Rendering it from the same array keeps the two copies
 * from drifting apart.
 */
const marquee = [...providers, ...providers];
---

<Base>
  <header class="nav-blur">
    <div class="wrap nav-inner">
      <a class="brand" href="#main" aria-label={`${site.name} home`}>
        <Logo />
        <span>Hilbras<span class="brand-sub">SDK</span></span>
      </a>
      <nav class="nav-links" aria-label="Sections">
        <a href="#capabilities">Capabilities</a>
        <a href="#how">How it works</a>
        <a href="#start">Get started</a>
        <a class="nav-cta" href={site.repository} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch theme">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="bg-glow hero-glow" aria-hidden="true"></div>
      <div class="grid-wash hero-grid" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <span class="eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          TypeScript LLM client · v{site.version}
        </span>
        <h1>One client.<br /><span class="gold-text">Every model.</span></h1>
        <p class="muted hero-sub">
          <code>{site.name}</code> puts {site.adapterCount} provider adapters behind a single API — streaming, tool calling
          and validated structured output — with budgets, retries and guardrails, and no runtime dependencies.
        </p>
        <div class="hero-actions">
          <a class="btn-gold" href={site.repository} target="_blank" rel="noreferrer">
            View on GitHub
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn-ghost" href="#start">Get started</a>
        </div>
        <div class="muted trust">
          <span><Tick size={12} />Zero runtime deps</span>
          <span><Tick size={12} />Typed end to end</span>
          <span><Tick size={12} />MIT licensed</span>
          <span><Tick size={12} />{site.testCount} tests</span>
        </div>

        <div class="hero-window">
          <div class="code-window">
<pre is:raw><span class="code-muted">// One client, any provider. Fallback and a spend cap included.</span>
<span class="code-key">import</span> { HilbrasClient } <span class="code-key">from</span> <span class="code-str">'@hilbras/sdk'</span>;

<span class="code-key">const</span> client = <span class="code-key">new</span> HilbrasClient({ budget: { sessionBudget: <span class="code-str">2.5</span> } });

client.addProvider({ name: <span class="code-str">'openai'</span>, apiKey: process.env.OPENAI_API_KEY });
client.addProvider({ name: <span class="code-str">'anthropic'</span>, apiKey: process.env.ANTHROPIC_API_KEY });

<span class="code-key">for await</span> (<span class="code-key">const</span> chunk <span class="code-key">of</span> client.stream({
  provider: <span class="code-str">'openai'</span>,
  model: <span class="code-str">'gpt-5.6-terra'</span>,
  messages: [{ role: <span class="code-str">'user'</span>, content: <span class="code-str">'Explain vector search'</span> }],
  fallback: [{ provider: <span class="code-str">'anthropic'</span>, model: <span class="code-str">'claude-sonnet-5'</span> }],
})) {
  <span class="code-key">if</span> (chunk.type === <span class="code-str">'text'</span>) process.stdout.write(chunk.text);
}
<span class="code-muted">// text · reasoning · tool_call · usage · finish — typed, every time</span></pre>
          </div>
        </div>
      </div>
      <div class="hairline"></div>
    </section>

    <!-- Providers -->
    <section class="band band-soft marquee-band" aria-label="Supported providers">
      <p class="muted marquee-label">Bring the providers you already use</p>
      <div class="wrap marquee-mask">
        <div class="marquee" aria-hidden="true">
          {marquee.map((provider) => (
            <span class="muted"><i class="tick">{provider.initial}</i>{provider.name}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Product -->
    <section class="band" id="capabilities">
      <div class="wrap section-pad">
        <SectionHead eyebrow="A calmer provider layer" title="Swap the model. Keep the code.">
          <p class="muted">
            Provider differences belong in one place. Your application keeps calling <code>stream()</code> and
            <code>complete()</code> while models, regions and vendors change underneath it.
          </p>
        </SectionHead>

        <div class="grid-3">
          <article class="card lift feature reveal">
            <span class="icon-tile">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="5" r="2"></circle>
                <circle cx="5" cy="19" r="2"></circle>
                <circle cx="19" cy="19" r="2"></circle>
                <path d="M12 7v4M7 17l4-4M17 17l-4-4"></path>
              </svg>
            </span>
            <h3>One API, {site.adapterCount} adapters</h3>
            <p>
              Register a provider, then call the same methods everywhere. Swapping a vendor is a string, not a rewrite —
              and the catalog knows each provider's models, context windows and pricing.
            </p>
            <span class="muted detail">{site.providerCount} providers · one client</span>
          </article>

          <article class="card lift feature reveal">
            <span class="icon-tile">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"></path></svg>
            </span>
            <h3>Streaming with real semantics</h3>
            <p>
              Every chunk is typed — text, reasoning, tool call, usage, finish. SSE framing handles CRLF, usage is
              accounted per provider, and a fallback that is configured actually runs.
            </p>
            <span class="muted detail">Typed chunks · first-chunk latency</span>
          </article>

          <article class="card lift feature reveal">
            <span class="icon-tile">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3l7 4v5c0 4.4-2.9 8.4-7 9-4.1-.6-7-4.6-7-9V7z"></path>
                <path d="M9 12l2 2 4-4"></path>
              </svg>
            </span>
            <h3>Guardrails that ship on</h3>
            <p>
              Session and per-request budgets with reservations, retries with capped backoff, a circuit breaker,
              fallback chains, RBAC, and an audit log that redacts credentials before writing.
            </p>
            <span class="muted detail">Budgets · retries · audit</span>
          </article>
        </div>
      </div>
    </section>

    <!-- Capabilities grid -->
    <section class="band band-soft">
      <div class="wrap section-pad">
        <SectionHead eyebrow="Everything in the box" title="Built for the parts that break." />
        <div class="grid-4">
          <div class="card cap reveal"><Tick /><span>Validated structured output, with a repair loop when the model returns malformed JSON</span></div>
          <div class="card cap reveal"><Tick /><span>Tool calling — native where the provider supports it, and text-embedded where it does not</span></div>
          <div class="card cap reveal"><Tick /><span>Cost tracking and budget alerts, priced per model</span></div>
          <div class="card cap reveal"><Tick /><span>Retries, timeouts and a circuit breaker per provider</span></div>
          <div class="card cap reveal"><Tick /><span>Fallback and priority routing across providers</span></div>
          <div class="card cap reveal"><Tick /><span>RBAC, an audit log, prompt-injection checks and PII redaction</span></div>
          <div class="card cap reveal"><Tick /><span>Hooks for React, Vue, Svelte, Solid, Qwik and Angular; handlers for Next.js, Astro and Remix</span></div>
          <div class="card cap reveal"><Tick /><span>Runs on Node 18+, Bun and Deno, with no runtime dependencies</span></div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="band" id="how">
      <div class="wrap section-pad">
        <SectionHead eyebrow="Three steps" title="From install to first token." />
        <div class="grid-3">
          <article class="card step reveal">
            <span class="step-num">01</span>
            <h3>Install it</h3>
            <p>One package, no transitive runtime dependencies. TypeScript types come with it.</p>
            <div class="code-window"><pre>npm install {site.name}</pre></div>
          </article>
          <article class="card step reveal">
            <span class="step-num">02</span>
            <h3>Add your providers</h3>
            <p>Bring keys for the services you already use, or point at a local Ollama endpoint.</p>
            <div class="code-window"><pre is:raw>client.addProvider({ name: <span class="code-str">'openai'</span>, apiKey })</pre></div>
          </article>
          <article class="card step reveal">
            <span class="step-num">03</span>
            <h3>Make one request</h3>
            <p>Stream or complete, with tools, schemas and fallback declared on the call.</p>
            <div class="code-window"><pre is:raw><span class="code-key">await</span> client.stream({ provider, model, messages })</pre></div>
          </article>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="closing" id="start">
      <div class="wrap">
        <div class="card reveal">
          <h2 class="section-title">Start with one provider.</h2>
          <p class="muted closing-lede">
            Add a second when you need it — routing, fallback and budgets are already there.
          </p>
          <div class="hero-actions">
            <a class="btn-gold" href={site.npm} target="_blank" rel="noreferrer">npm install {site.name}</a>
            <a class="btn-ghost" href={`${site.repository}#readme`} target="_blank" rel="noreferrer">Read the docs</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="band-soft">
    <div class="wrap foot">
      <span class="muted">© <span id="year">2026</span> {site.brand} · {site.license} licensed</span>
      <nav aria-label="Footer">
        <a href={site.repository} target="_blank" rel="noreferrer">GitHub</a>
        <a href={site.npm} target="_blank" rel="noreferrer">npm</a>
        <a href={site.changelog} target="_blank" rel="noreferrer">Changelog</a>
        <a href={site.licenseUrl} target="_blank" rel="noreferrer">License</a>
      </nav>
    </div>
  </footer>
</Base>
