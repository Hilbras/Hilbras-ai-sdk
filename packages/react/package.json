{
  "name": "@hilbras/react",
  "version": "2.0.0",
  "description": "React hooks and components for @hilbras/sdk — streaming chat, completion, cost tracking",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs dist && tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hilbras/sdk": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "llm",
    "react",
    "hooks",
    "chat",
    "openai",
    "anthropic",
    "streaming"
  ]
}
