{
  "name": "@hilbras/ui",
  "version": "2.1.0",
  "description": "Headless React UI components for AI chat, completion, and cost tracking",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/index.d.ts",
      "import": "./dist/tailwind/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs dist && tsc",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hilbras/react": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "ui",
    "chat",
    "components",
    "headless",
    "tailwind",
    "react"
  ]
}
