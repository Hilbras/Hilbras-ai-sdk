{
  "name": "@hilbras/next",
  "version": "2.2.0",
  "description": "Next.js integration for @hilbras/sdk — streaming API routes, middleware, edge runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs dist && tsc",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hilbras/sdk": "^3.0.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "next": "^16.3.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "nextjs",
    "streaming",
    "edge",
    "openai",
    "anthropic"
  ]
}
